# ==============================================================================
# MAINTENX OS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:hitesha2004@localhost:5432/maintenxos
# JWT Authentication Secrets
JWT_SECRET=super-secure-maintenx-os-jwt-secret-key-2026-manufacturing-cloud
JWT_REFRESH_SECRET=super-secure-maintenx-os-refresh-secret-key-2026-token
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# ==============================================================================
# THIRD-PARTY INTEGRATIONS CONFIGURATION
# ==============================================================================

# AI Assistant Integration (openai | gemini | claude | mock)
AI_PROVIDER=mock
AI_API_KEY=YOUR_AI_API_KEY_HERE
AI_MODEL=gpt-4o-mini

# Razorpay Billing Integration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_2026
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_2026

# PLC / Industrial IoT Connectivity
IOT_SIMULATOR_ENABLED=true
IOT_SIMULATOR_INTERVAL_MS=3000
