# ==============================================================================
# MAINTENX OS - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/maintenxos

# JWT Authentication Secrets
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_KEY_HERE
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# ==============================================================================
# REQUIRED THIRD-PARTY INTEGRATIONS CONFIGURATION
# ==============================================================================

# 1. AI Assistant Integration
# Supported providers: openai | gemini | claude | mock
AI_PROVIDER=mock
AI_API_KEY=YOUR_AI_API_KEY_HERE
AI_MODEL=gpt-4o-mini

# 2. Razorpay Billing Integration
# Get your API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# 3. PLC / Industrial IoT Connectivity
IOT_SIMULATOR_ENABLED=true
IOT_SIMULATOR_INTERVAL_MS=3000
